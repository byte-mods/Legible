{
  "name": "legible",
  "version": "1.0.0",
  "description": "Turn research papers, RFCs and specs into plain-English explainers with diagrams, an autoplaying illustrated reel, 16-language narration, and interactive 2D/3D simulators. Runs locally, stores everything in SQLite.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "server/index.js",
  "private": false,
  "keywords": [
    "research",
    "papers",
    "rfc",
    "explainer",
    "llm",
    "claude",
    "sqlite",
    "threejs",
    "shorts",
    "pdf",
    "local-first"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "host": "./host.sh --public",
    "lan": "./host.sh --lan",
    "local": "./host.sh --local"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^12.4.1",
    "dompurify": "^3.2.7",
    "express": "^5.1.0",
    "jsdom": "^28.0.0",
    "mammoth": "^1.11.0",
    "marked": "^18.0.9",
    "mermaid": "^11.12.0",
    "multer": "^2.0.2",
    "pdf-parse": "^2.4.5",
    "three": "^0.185.1"
  }
}
